<!DOCTYPE html>
<html lang="pt-BR">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Agenda{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>📅</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {# Entrypoint do site: Stimulus e o CSS do Tailwind #}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body class="flex min-h-screen flex-col bg-slate-50 text-slate-800 antialiased">
        <header class="border-b border-slate-200 bg-white">
            <div class="mx-auto flex max-w-5xl items-center px-4 py-4">
                <a href="{{ path('site_home') }}" class="text-2xl font-bold tracking-tight text-indigo-700 hover:text-indigo-900">Agenda</a>
            </div>
        </header>

        <main class="mx-auto w-full max-w-5xl flex-1 px-4 py-8">
            {% block body %}{% endblock %}
        </main>

        <footer class="border-t border-slate-200 bg-white">
            <div class="mx-auto max-w-5xl px-4 py-6 text-sm text-slate-500">
                Agenda de Eventos · {{ 'now'|date('Y') }}
            </div>
        </footer>
    </body>
</html>

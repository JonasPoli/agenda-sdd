{% extends 'admin/base.html.twig' %}

{% block title %}Eventos{% endblock %}
{% block titulo_pagina %}Eventos{% endblock %}

{% block acoes %}
    <wa-button variant="brand" href="{{ path('admin_evento_novo') }}">
        <wa-icon slot="start" name="plus"></wa-icon> Novo evento
    </wa-button>
{% endblock %}

{% block body %}
    {% if eventos is empty %}
        <div class="admin-painel-quadro estado-vazio">Nenhum evento cadastrado.</div>
    {% else %}
        <div data-controller="confirmar-exclusao">
            <table class="admin-tabela">
                <thead>
                    <tr>
                        <th>Título</th>
                        <th>Início</th>
                        <th>Local</th>
                        <th>Categoria</th>
                        <th>Situação</th>
                        <th class="acoes"><span class="wa-visually-hidden">Ações</span></th>
                    </tr>
                </thead>
                <tbody>
                    {% for evento in eventos %}
                        <tr>
                            <td>{{ evento.titulo }}</td>
                            <td class="data">{{ evento.inicio|date('d/m/Y H:i') }}</td>
                            <td>{{ evento.local ?? '—' }}</td>
                            <td>{{ include('admin/_selo_categoria.html.twig', {categoria: evento.categoria}) }}</td>
                            <td>
                                {% if evento.publicado %}
                                    <wa-badge variant="success">Publicado</wa-badge>
                                {% else %}
                                    <wa-badge variant="warning">Rascunho</wa-badge>
                                {% endif %}
                            </td>
                            <td class="acoes">
                                <wa-button size="small" appearance="plain" href="{{ path('admin_evento_editar', {id: evento.id}) }}">
                                    <wa-icon slot="start" name="pen"></wa-icon> Editar
                                </wa-button>
                                {{ include('admin/_botao_excluir.html.twig', {
                                    url: path('admin_evento_excluir', {id: evento.id}),
                                    token: csrf_token('excluir_evento_' ~ evento.id),
                                    titulo: 'o evento "' ~ evento.titulo ~ '"',
                                }) }}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>

            {{ include('admin/_dialogo_exclusao.html.twig') }}
        </div>
    {% endif %}
{% endblock %}

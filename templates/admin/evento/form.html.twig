{% extends 'admin/base.html.twig' %}

{% block title %}{{ titulo }}{% endblock %}
{% block titulo_pagina %}{{ titulo }}{% endblock %}

{% block body %}
    <div class="admin-painel-quadro">
        {# novalidate: as regras são do servidor e os erros aparecem junto ao campo #}
        {{ form_start(form, {attr: {class: 'admin-formulario', novalidate: 'novalidate'}}) }}
            {{ form_row(form.titulo) }}

            {% if evento.slug %}
                <div class="campo">
                    <label for="evento_slug">Endereço (slug)</label>
                    <input type="text" id="evento_slug" value="{{ evento.slug }}" readonly aria-describedby="evento_slug_ajuda">
                    <div id="evento_slug_ajuda" class="campo-ajuda">Gerado do título na criação; não muda quando o título é editado.</div>
                </div>
            {% endif %}

            {{ form_row(form.resumo) }}
            {{ form_row(form.descricao) }}
            {{ form_row(form.inicio) }}
            {{ form_row(form.local) }}
            {{ form_row(form.categoria) }}
            {{ form_row(form.publicado) }}
            <div class="botoes">
                <wa-button type="submit" variant="brand">
                    <wa-icon slot="start" name="floppy-disk"></wa-icon> Salvar
                </wa-button>
                <wa-button appearance="outlined" href="{{ path('admin_evento_index') }}">Cancelar</wa-button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}

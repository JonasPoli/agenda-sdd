{% extends 'base.html.twig' %}

{% block title %}{{ evento.titulo }} · Agenda{% endblock %}

{% block body %}
    <a href="{{ path('site_home') }}" class="mb-6 inline-block text-sm font-medium text-indigo-700 hover:text-indigo-900">← Voltar para a agenda</a>

    <article class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="mb-3">{{ include('site/_selo_categoria.html.twig', {categoria: evento.categoria}) }}</div>
        <h1 class="mb-4 text-3xl font-bold break-words text-slate-900">{{ evento.titulo }}</h1>

        <dl class="mb-6 grid gap-2 text-slate-700 sm:grid-cols-[auto_1fr] sm:gap-x-4">
            <dt class="font-semibold">Data e hora</dt>
            <dd><time datetime="{{ evento.inicio|date('Y-m-d\\TH:i') }}">{{ evento.inicio|date('d/m/Y H:i') }}</time></dd>
            {% if evento.local %}
                <dt class="font-semibold">Local</dt>
                <dd class="break-words">{{ evento.local }}</dd>
            {% endif %}
        </dl>

        {% if evento.resumo %}
            <p class="mb-6 text-lg break-words text-slate-700">{{ evento.resumo }}</p>
        {% endif %}

        {% if evento.descricao %}
            {# Texto escapado antes do nl2br: preserva as quebras de linha sem aceitar HTML #}
            <div class="leading-relaxed break-words text-slate-800">{{ evento.descricao|e|nl2br }}</div>
        {% endif %}
    </article>
{% endblock %}

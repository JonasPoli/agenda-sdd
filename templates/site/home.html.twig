{% extends 'base.html.twig' %}

{% block title %}Próximos eventos · Agenda{% endblock %}

{% block body %}
    <h1 class="sr-only">Agenda de eventos</h1>

    {% if destaques is empty and eventos is empty %}
        <h2 class="mb-6 text-3xl font-bold text-slate-900">Próximos eventos</h2>
        <p class="rounded-lg border border-slate-200 bg-white p-8 text-center text-slate-500">Nenhum evento agendado no momento.</p>
    {% endif %}

    {# Até 3 destaques publicados, os mais próximos; eles não se repetem na lista abaixo #}
    {% if destaques is not empty %}
        <section aria-labelledby="titulo-destaques" class="mb-10 rounded-2xl border border-amber-200 bg-amber-50 p-5 sm:p-6">
            <h2 id="titulo-destaques" class="mb-5 flex items-center gap-2 text-2xl font-bold text-slate-900">
                <span aria-hidden="true" class="text-amber-500">★</span> Em destaque
            </h2>
            <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for evento in destaques %}
                    <li>
                        {{ include('site/_card_evento.html.twig', {evento: evento}) }}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}

    {% if eventos is not empty %}
        <section aria-labelledby="titulo-proximos">
            <h2 id="titulo-proximos" class="mb-6 text-3xl font-bold text-slate-900">Próximos eventos</h2>
            <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
                {% for evento in eventos %}
                    <li>
                        {{ include('site/_card_evento.html.twig', {evento: evento}) }}
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
{% endblock %}

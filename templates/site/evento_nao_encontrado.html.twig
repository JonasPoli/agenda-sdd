{% extends 'base.html.twig' %}

{# Mesma página para slug inexistente e para rascunho: não revela que o evento existe #}
{% block title %}Evento não encontrado · Agenda{% endblock %}

{% block body %}
    <section class="rounded-xl border border-slate-200 bg-white p-8 text-center shadow-sm sm:p-12">
        <p class="mb-2 text-sm font-semibold tracking-wide text-indigo-700">Erro 404</p>
        <h1 class="mb-4 text-3xl font-bold text-slate-900">Evento não encontrado</h1>
        <p class="mx-auto mb-8 max-w-md text-slate-600">O evento que você procura não existe ou não está disponível no momento.</p>
        <a href="{{ path('site_home') }}" class="inline-block rounded-lg bg-indigo-700 px-5 py-2.5 font-medium text-white hover:bg-indigo-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 focus-visible:ring-offset-2">Ver a agenda</a>
    </section>
